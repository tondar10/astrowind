---
import { SITE } from 'astrowind:config';
import { Icon } from 'astro-icon/components';
---

<span
  class="self-center ml-2 rtl:ml-0 rtl:mr-2 text-2xl md:text-xl font-bold text-gray-900 whitespace-nowrap dark:text-white flex items-center gap-2"
>
  <!-- آیکون خورشید و انرژی پاک برای شرکت پرتو توان تدبیر -->
  <Icon name="tabler:sun-electricity" class="w-8 h-8 text-amber-500 inline-block" />
  {SITE?.name || 'پرتو توان تدبیر'}
</span>
