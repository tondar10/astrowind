---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'شرکت پرتو توان تدبیر | احداث و توسعه نیروگاه‌های خورشیدی',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'مشاوره و درخواست احداث',
        href: '#contact',
        icon: 'tabler:sun',
      },
      { text: 'خدمات ما', href: '#features' },
    ]}
    image={{ src: '/images/hero-image.png', alt: 'نیروگاه خورشیدی پرتو توان تدبیر' }}
  >
    <Fragment slot="title">
      تأمین انرژی پاک و پایدار با <span class="text-accent dark:text-white highlight">پرتو توان تدبیر</span>
    </Fragment>

    <Fragment slot="subtitle">
      مجری تخصصی مشاوره، طراحی، احداث و نگهداری نیروگاه‌های خورشیدی صنعتی، خانگی و کشاورزی با بالاترین بازدهی و ضمانت رسمی.
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note title="ماموریت ما:" description="ارائه راهکارهای نوین انرژی تجدیدپذیر، کاهش هزینه‌های برق و حرکت به سوی آینده‌ای پاک." />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="خدمات اصلی"
    title="خدمات جامع شرکت پرتو توان تدبیر"
    subtitle="از مطالعات امکان‌سنجی اولیه تا نصب، اتصال به شبکه سراسری و پشتیبانی دائمی نیروگاه‌های خورشیدی."
    items={[
      {
        title: 'نیروگاه‌های خورشیدی صنعتی',
        description:
          'احداث نیروگاه‌های خورشیدی بزرگ‌مقیاس برای صنایع و کارخانجات جهت رفع ناترازی برق و تامین انرژی پایدار.',
        icon: 'tabler:building-factory-2',
      },
      {
        title: 'سیستم‌های خورشیدی خانگی (On-Grid)',
        description:
          'طراحی و نصب سیستم‌های پشت‌بامی جهت فروش تضمینی برق به وزارت نیرو و درآمدزایی مطمئن ۲۰ ساله.',
        icon: 'tabler:home-bolt',
      },
      {
        title: 'سیستم‌های مستقل از شبکه (Off-Grid)',
        description:
          'تامین برق با بانک باتری پیشرفته برای مزارع، ویلاها و مناطقی که به شبکه سراسری برق دسترسی ندارند.',
        icon: 'tabler:battery-charging',
      },
      {
        title: 'طراحی مهندسی و مشاوره (EPC)',
        description:
          'شبیه‌سازی تخصصی تابش، محاسبه دقیق بازدهی و اجرای کامل پروژه‌ها بر اساس استانداردهای بین‌المللی.',
        icon: 'tabler:solar-panel-2',
      },
      {
        title: 'تامین تجهیزات اورجینال',
        description:
          'عرضه مستقیم بهترین پنل‌های خورشیدی، اینورترها و استراکچرهای مقاوم با گارانتی معتبر.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'پایش، سرویس و نگهداری (O&M)',
        description:
          'بازرسی‌های دوره‌ای، شستشوی تخصصی پنل‌ها و مانیتورینگ آنلاین جهت حفظ حداکثر راندمان نیروگاه.',
        icon: 'tabler:tools',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="چرا پرتو توان تدبیر؟"
    title="مزایای احداث نیروگاه خورشیدی با ما"
    items={[
      {
        title: 'تیم مهندسی باسابقه و متخصص',
        description:
          'بهره‌گیری از مهندسان مجرب در حوزه برق و انرژی‌های تجدیدپذیر با سابقه اجرای پروژه‌های ملی.',
      },
      {
        title: 'تجهیزات با گارانتی طولانی‌مدت',
        description:
          'استفاده از پنل‌ها و اینورترهای دارای راندمان بالا و گارانتی راندمان ۲۵ ساله.',
      },
      {
        title: 'بازگشت سریع سرمایه',
        description:
          'محاسبه دقیق توجیه اقتصادی و کاهش دوره بازگشت سرمایه با بهینه‌سازی طراحی فنی.',
      },
    ]}
    image={{
      src: 'src/assets/images/hero-image.png',
      alt: 'مهندسی نیروگاه خورشیدی',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">سرمایه‌گذاری مطمئن و سبز</h3>
      با احداث نیروگاه خورشیدی، علاوه بر کاهش هزینه‌ها، سهم مهمی در حفاظت از محیط زیست داشته باشید.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="مراحل اجرای پروژه نیروگاه خورشیدی شما"
    items={[
      {
        title: 'گام ۱: <span class="font-medium">مشاوره و بازدید میدانی</span>',
        description:
          'بررسی موقعیت مکانی، میزان تابش خورشید، زاویه نصب و سنجش زیرساخت‌های الکتریکی محل پروژه.',
        icon: 'tabler:map-pin',
      },
      {
        title: 'گام ۲: <span class="font-medium">طراحی فنی و طرح توجیهی</span>',
        description:
          'شبیه‌سازی نرم‌افزاری، انتخاب دقیق تجهیزات و ارائه برآورد مالی و بازگشت سرمایه.',
        icon: 'tabler:report-analytics',
      },
      {
        title: 'گام ۳: <span class="font-medium">نصب و راه‌اندازی</span>',
        description:
          'مونتاژ استراکچر، نصب پنل‌ها، کابل‌کشی و اتصال اینورترها با رعایت کامل نکات ایمنی.',
        icon: 'tabler:tools',
      },
      {
        title: 'تحویل و اتصال به شبکه!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1613665813446-82a78c468a1d?auto=format&fit=crop&w=1000&q=80',
      alt: 'مراحل نصب نیروگاه خورشیدی',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="تجهیزات و راهکارهای خورشیدی"
    subtitle="ارائه بهترین قطعات و سیستم‌های استاندارد صنعت انرژی خورشیدی"
    tagline="تجهیزات"
    items={[
      {
        title: 'پنل‌های خورشیدی',
        description: 'تامین انواع پنل‌های مونوکریستال و تایپ N با راندمان فوق‌العاده بالا.',
        icon: 'flat-color-icons:template',
      },
      {
        title: 'اینورترهای خورشیدی',
        description: 'اینورترهای متصل به شبکه (On-Grid) و هیبرید از برندهای معتبر جهانی.',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'سازه‌ها و استراکچر',
        description: 'سازه‌های گالوانیزه گرم مقاوم در برابر بادهای شدید و شرایط آب و هوایی سخت.',
        icon: 'flat-color-icons:document',
      },
      {
        title: 'باتری‌های ذخیره‌سازی',
        description: 'باتری‌های لیتیومی و ژل با طول عمر بالا برای سیستم‌های مستقل از شبکه.',
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="آخرین اخبار و مقالات آموزشی"
    information="جدیدترین اخبار حوزه انرژی‌های تجدیدپذیر، راهنماهای کاربردی احداث نیروگاه و تحلیل‌های اقتصادی صنعت خورشیدی را مطالعه کنید."
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="سوالات متداول"
    subtitle="پاسخ به برخی از رایج‌ترین سوالات شما درباره احداث نیروگاه خورشیدی"
    tagline="سوالات"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'طول عمر یک نیروگاه خورشیدی چقدر است؟',
        description:
          'پنل‌های خورشیدی استاندارد معمولاً دارای گارانتی راندمان ۲۵ ساله هستند و نیروگاه می‌تواند بیش از ۳۰ سال با کارایی مطلوب انرژی تولید کند.',
      },
      {
        title: 'قرارداد فروش تضمینی برق چیست؟',
        description:
          'وزارت نیرو برق تولیدی نیروگاه‌های خورشیدی شما را بر اساس قراردادی ۲۰ ساله به صورت تضمینی خرید می‌کند و درآمد ماهانه برای شما ایجاد خواهد شد.',
      },
      {
        title: 'دوره بازگشت سرمایه در نیروگاه خورشیدی چقدر است؟',
        description:
          'بسته به نوع نیروگاه (خانگی یا صنعتی) و نرخ‌های خریدهای تضمینی، معمولاً بازگشت سرمایه بین ۳ تا ۵ سال زمان می‌برد.',
      },
      {
        title: 'آیا نیروگاه خورشیدی در روزهای ابری هم برق تولید می‌کند؟',
        description:
          'بله، پنل‌های خورشیدی با دریافت نور غیرمستقیم محیطی نیز فعال هستند، اما میزان تولید برق نسبت به روزهای آفتابی کاهش می‌یابد.',
      },
    ]}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: 'مگاوات ظرفیت نصب‌شده', amount: '+۵۰' },
      { title: 'پروژه‌های اجراشده', amount: '+۱۲۰' },
      { title: 'رضایت مشتریان', amount: '۱۰۰٪' },
      { title: 'کاهش کربن (تن)', amount: '+۸۰K' },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    id="contact"
    actions={[
      {
        variant: 'primary',
        text: 'تماس با کارشناسان',
        href: 'tel:02144127942',
        icon: 'tabler:phone-call',
      },
    ]}
  >
    <Fragment slot="title">
      آینده انرژی خود را همین امروز با پرتو توان تدبیر بسازید
    </Fragment>

    <Fragment slot="subtitle">
      برای برآورد هزینه احداث نیروگاه و دریافت مشاوره تخصصی رایگان با تیم ما در ارتباط باشید.
    </Fragment>
  </CallToAction>
</Layout>
